doctype html
html(lang='hr')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title Podaci propusnice
  body
    h1 Podaci propusnice
    p Ime i prezime: #{pass.name}
    p Oznaka dokumenta: #{pass.document}
    p Vrijeme izdavanja: #{pass.issuedAt.toISOString()}
    p Status: #{pass.status}
