doctype html
html(lang='hr')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title Pregled propusnica
  body
    h1 Pregled propusnica
    a(href='/') Početna
    if passes.length === 0
      p Nema propusnica.
    else
      table
        thead
          tr
            th Ime i prezime
            th Dokument
            th Vrijeme izdavanja
            th Status
            th Akcije
        tbody
          each pass in passes
            tr
              td= pass.name
              td= pass.document
              td= pass.issuedAt.toISOString()
              td= pass.status
              td
                if pass.status === 'ACTIVE'
                  form(action=`/admin/passes/${pass.id}/cancel`, method='post')
                    button(type='submit') Poništi
                form(action=`/admin/passes/${pass.id}/delete`, method='post')
                  button(type='submit') Obriši
